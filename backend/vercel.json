{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "npm ci --include=dev",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.js": {
            "includeFiles": "node_modules/argon2/prebuilds/**"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ]
}