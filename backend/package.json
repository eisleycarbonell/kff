{
    "name": "boilerplate",
    "version": "1.0.0",
    "description": "express typescript",
    "license": "ISC",
    "author": "eisley carbonell",
    "type": "module",
    "main": "dist/src/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:test": "tsx watch src/start-test.ts",
        "build": "tsc",
        "start": "node dist/src/index.js",
        "start:test": "node dist/src/start-test.js",
        "fresh-start": "npm run db:fresh-start && npm run build && npm start",
        "fresh-start:dev": "npm run db:fresh-start && npm run dev",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types --test tests/*.test.ts",
        "format": "prettier --write \"src/**/*.{js,ts}\"",
        "db:fresh-start": "node --experimental-strip-types src/db/fresh-start.ts --allow",
        "db:rebuild": "node --experimental-strip-types src/db/rebuild.ts --allow",
        "db:seed": "node --experimental-strip-types src/db/seed.ts --allow",
        "db:create-demo-user": "node --experimental-strip-types src/db/create-demo-user.ts",
        "db:upgrade:demo": "node --experimental-strip-types src/db/upgrade-demo-data.ts --allow",
        "db:push": "npx drizzle-kit push",
        "db:studio": "npx drizzle-kit studio",
        "db:migrate:controls": "node --experimental-strip-types src/db/migrate-controls.ts",
        "db:migrate:customer-planning": "node --experimental-strip-types src/db/migrate-customer-planning.ts",
        "db:migrate:vat": "node --experimental-strip-types src/db/migrate-vat.ts",
        "db:migrate:indexes": "tsx src/db/migrate-indexes.ts"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^1.0.0-rc.4",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "6.0.3"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.119.0",
        "argon2": "^0.45.1",
        "cors": "^2.8.6",
        "dotenv": "^18.0.6",
        "drizzle-orm": "^1.0.0-rc.4",
        "express": "^5.2.1",
        "jose": "^6.2.12",
        "pg": "^8.23.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "postgres": "^3.4.9",
        "socket.io": "^4.8.4",
        "zod": "^4.6.7"
    },
    "keywords": [],
    "engines": {
        "node": ">=24"
    },
    "allowScripts": {
        "argon2@0.45.1": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true
    }
}
