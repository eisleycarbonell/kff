{
    "name": "boilerplate",
    "version": "1.0.0",
    "description": "express typescript",
    "license": "ISC",
    "author": "eisley carbonell",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "format": "prettier --write \"src/**/*.{js,ts}\"",
        "test": "node --experimental-strip-types --test tests/*.test.ts",
        "typecheck": "tsc --noEmit",
        "db:push": "npx drizzle-kit push",
        "db:studio": "npx drizzle-kit studio",
        "db:create-demo-user": "node src/db/create-demo-user.ts",
        "db:seed": "tsx src/db/seed.ts",
        "build": "tsc",
        "start": "node dist/src/index.js"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.3",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^1.0.0-rc.4",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "argon2": "^0.45.1",
        "cors": "^2.8.6",
        "dotenv": "^18.0.6",
        "drizzle-orm": "^1.0.0-rc.4",
        "express": "^5.2.1",
        "jose": "^6.2.12",
        "pg": "^8.23.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "postgres": "^3.4.9",
        "zod": "^4.6.7"
    },
    "keywords": []
}
