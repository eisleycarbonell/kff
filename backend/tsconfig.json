{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "strictNullChecks": true,
        "outDir": "./dist",
        "noEmit": false
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "drizzle.config.ts"
    ],
}