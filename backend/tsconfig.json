{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "strictNullChecks": true,
        "outDir": "./dist",
        "noEmit": false,
        "types": [
            "node"
        ],
    },
    "include": [
        "src/**/*.ts",
        "drizzle.config.ts"
    ],
    "exclude": [
        "node_modules",
        "tests",
        "**/*.test.ts",
        "**/*.spec.ts"
    ]
}