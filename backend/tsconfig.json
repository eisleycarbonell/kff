{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "strictNullChecks": true
    }
}