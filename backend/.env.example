# ==============================================================================
# KFF Backend Environment Template
# Copy to `.env` for local development or configure in your hosting provider.
# Never commit real `.env` credentials or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Set to false on serverless runtimes (Vercel); frontend falls back to 30s polling
REALTIME_ENABLED=true

# ------------------------------------------------------------------------------
# Authentication, CORS & Frontend Cookie Settings
# ------------------------------------------------------------------------------
# Strong random string used to sign and verify session and Socket.IO JWTs
JWT_SECRET=replace-with-strong-random-secret

# Comma-separated allowed frontend origins (trailing slashes stripped)
CORS_ORIGIN=http://localhost:3000

# Cookie SameSite policy for the `jwt` httpOnly session cookie:
# - strict : local dev or same-origin proxy (frontend rewrites /api/* -> backend)
# - lax    : same-site subdomain deployments
# - none   : direct cross-origin browser requests (requires HTTPS / secure=true)
COOKIE_SAME_SITE=strict

# ------------------------------------------------------------------------------
# PostgreSQL / Supabase Database Connection
# Resolution priority is handled in src/db/connection.ts
# ------------------------------------------------------------------------------
# Primary connection string (local PostgreSQL or Supabase transaction pooler)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kff

# Optional local-only override checked first when NODE_ENV=development
# LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kff

# Optional direct non-pooled PostgreSQL URL (used by drizzle-kit push & CLI scripts)
# DIRECT_URL=postgres://postgres:postgres@localhost:5432/kff

# Optional production Supabase pooled / direct URLs
# SUPABASE_DB_URL=
# SUPABASE_DIRECT_URL=

# Optional connection tuning overrides (auto-detected for localhost vs Supabase)
# DB_SSL=disable
# DB_PREPARE=true
# DB_POOL_MAX=10

# Optional Supabase client credentials (used by src/db/supabase.ts)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Local Testing & Demo User Helpers (Never enable in production)
# Test/demo npm scripts (`db:seed`, `db:rebuild`, `dev:test`, `start:test`)
# enable test-data mode automatically when invoked; leave unset in `.env`.
# ------------------------------------------------------------------------------
# DEMO_USER_EMAIL=demo@spice.local
# DEMO_USER_PASSWORD=KffDemo123!
