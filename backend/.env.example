# Server
NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000

# Cross-site cookie support when frontend and backend are deployed on separate domains (HTTPS):
# Use "none" for separate Vercel frontend/backend URLs, or "strict" when same-origin.
COOKIE_SAME_SITE=strict

# PostgreSQL / Supabase (Drizzle ORM + postgres.js)
# Local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/kff
#
# Supabase Transaction Pooler (recommended for Vercel / serverless runtime):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Supabase Session Pooler or Direct Connection (used by Drizzle CLI push/migrations):
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Supabase JS Data API Client (@supabase/supabase-js):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
#
# Note: Vercel's Supabase integration variables (DATABASE_POSTGRES_URL,
# DATABASE_POSTGRES_PRISMA_URL, DATABASE_POSTGRES_URL_NON_POOLING,
# DATABASE_SUPABASE_URL, DATABASE_SUPABASE_ANON_KEY,
# DATABASE_SUPABASE_SERVICE_ROLE_KEY) are also automatically supported.
#
# Optional overrides:
# DB_SSL=require
# DB_PREPARE=false
# DB_POOL_MAX=1
