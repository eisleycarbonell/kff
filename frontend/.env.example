# ==============================================================================
# KFF Frontend Environment Template
# Copy to `.env.local` (or `.env`) for local development, or configure in Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# Local Development / Direct Backend API Origin
# Include the `/api` suffix and omit trailing slashes.
# Restart `next dev` (or rebuild) after changing NEXT_PUBLIC_* variables.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# ------------------------------------------------------------------------------
# Optional Explicit Socket.IO Origin
# Defaults to NEXT_PUBLIC_API_BASE_URL with `/api` stripped.
# Useful in production when REST uses `/api/*` rewrite proxy while Socket.IO
# connects directly to the backend host with `/api/auth/socket-token`.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Production Separate-Domain API Proxy (next.config.ts)
# When NODE_ENV=production and one of BACKEND_URL / API_PROXY_TARGET is set,
# next.config.ts sets NEXT_PUBLIC_API_PROXY=true and rewrites `/api/:path*` to
# `${BACKEND_URL}/api/:path*` so browser cookies remain same-origin.
# ------------------------------------------------------------------------------
# BACKEND_URL=https://api.example.com
# API_PROXY_TARGET=https://api.example.com
